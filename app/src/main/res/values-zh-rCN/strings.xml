<resources>
    <string name="ime_label">语音输入（fcitx5 插件）</string>
    <string name="subtype_voice_name">语音输入</string>

    <string name="plugin_description">通过 OpenAI 兼容的音频转写接口（Whisper / v1/audio/transcriptions）为 fcitx5-android 提供网络语音识别。在 fcitx5-android 键盘设置中启用语音输入按钮后，点击键盘上的麦克风图标即切换到本输入法并开始录音。</string>

    <string name="settings_title">语音输入设置</string>

    <string name="pref_category_api">API（OpenAI 兼容接口）</string>
    <string name="pref_base_url_title">Base URL</string>
    <string name="pref_base_url_summary">例如 https://api.openai.com/v1</string>
    <string name="pref_base_url_dialog">OpenAI 兼容的 Base URL，插件将请求 POST {baseUrl}/audio/transcriptions</string>
    <string name="pref_api_key_title">API Key</string>
    <string name="pref_api_key_summary">以 Bearer Token 方式发送</string>
    <string name="pref_api_key_dialog">你的 API Key（Authorization: Bearer …）</string>
    <string name="pref_model_title">模型名称</string>
    <string name="pref_model_summary">例如 whisper-1</string>
    <string name="pref_model_dialog">传给转写接口的模型名</string>
    <string name="pref_language_title">识别语言</string>
    <string name="pref_language_summary">auto 表示自动检测</string>

    <string name="pref_category_recording">录音</string>
    <string name="pref_auto_start_title">切换后立即开始录音</string>
    <string name="pref_auto_start_summary">点击 fcitx5 键盘上的麦克风图标切换到本输入法后，自动开始录音</string>
    <string name="pref_grant_permission_title">麦克风权限</string>
    <string name="pref_grant_permission_summary">点击授予录音权限（RECORD_AUDIO），语音输入必需</string>
    <string name="pref_auto_return_title">收起键盘后返回 fcitx5</string>
    <string name="pref_auto_return_summary">识别完成后停留在语音界面可连续听写；当你收起输入窗口后，下次唤起键盘自动回到 fcitx5</string>
    <string name="pref_test_api_title">测试连接</string>
    <string name="pref_test_api_summary">录制 2 秒并执行一次转写，验证配置是否正确</string>

    <string name="pref_category_help">使用帮助</string>
    <string name="pref_enable_ime_title">启用本输入法</string>
    <string name="pref_enable_ime_summary">打开 Android 输入法设置，勾选「语音输入（fcitx5 插件）」</string>
    <string name="pref_usage_hint">1. 先启用本输入法；\n2. 在 fcitx5-android → 键盘设置中打开「显示语音输入按钮」，并选择本语音输入法；\n3. 点击键盘上的麦克风图标进入语音界面，**按住**中央按钮说话，**松开**后自动识别并把文字输入到当前输入框。</string>

