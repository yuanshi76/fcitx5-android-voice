    <string name="ime_label">Voice Input (FCITX5 Plugin)</string>
    <string name="subtype_voice_name">Voice Input</string>

    <string name="plugin_description">Network speech recognition for fcitx5-android via an OpenAI-compatible audio transcription API (Whisper / v1/audio/transcriptions). Enable the voice (microphone) button in fcitx5-android keyboard settings; tapping it switches to this input method and starts recording.</string>

