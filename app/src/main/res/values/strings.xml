    <string name="pref_category_recording">Recording</string>
    <string name="pref_auto_start_title">Auto start on switch</string>
    <string name="pref_auto_start_summary">Begin recording immediately when this input method is activated (the moment you tap the microphone button on the fcitx5 keyboard)</string>
    <string name="pref_grant_permission_title">Microphone permission</string>
    <string name="pref_grant_permission_summary">Tap to grant RECORD_AUDIO permission (required for dictation)</string>
    <string name="pref_auto_return_title">Return to fcitx5 when keyboard hides</string>
    <string name="pref_auto_return_summary">Stay on the voice panel after a commit for continuous dictation; next time the keyboard is summoned it will be fcitx5 again</string>
    <string name="pref_test_api_title">Test connection</string>
    <string name="pref_test_api_summary">Record 2 seconds and run a transcription to verify the configuration</string>

    <string name="pref_category_help">Getting started</string>
    <string name="pref_enable_ime_title">Enable this input method</string>
    <string name="pref_enable_ime_summary">Open Android input method settings and check “Voice Input (FCITX5 Plugin)”</string>
    <string name="pref_usage_hint">1. Enable the input method above.\n2. In fcitx5-android → Keyboard settings, turn on “Show voice input button” and pick this voice input.\n3. Tap the microphone icon on the keyboard to open the voice panel, then **press and hold** the center button to talk and **release** to recognize and insert the text.</string>

